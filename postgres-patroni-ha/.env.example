# ============================================================
# PostgreSQL + Patroni HA Lab — Environment Variables
# ============================================================
# IMPORTANT: Copy this file to .env before starting the cluster.
#   cp .env.example .env
#
# These are LOCAL LAB credentials only.
# Do NOT use these values in production.
# Do NOT commit the .env file to version control.
# ============================================================

# PostgreSQL superuser (used by Patroni for cluster management)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres-ha-lab-2024

# Replication user (used for streaming replication between nodes)
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator-ha-lab-2024

# Application user (used by the sample application database)
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=appuser-ha-lab-2024
POSTGRES_APP_DATABASE=appdb
