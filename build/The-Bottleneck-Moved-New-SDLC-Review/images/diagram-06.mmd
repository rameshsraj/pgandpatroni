graph LR
    subgraph C["Conductor"]
        direction TB
        C1["Real time, in the editor"]
        C2["You watch every step"]
        C3["Good for: exploring,<br/>unfamiliar code,<br/>problems you cannot<br/>yet describe"]
    end

    subgraph O["Orchestrator"]
        direction TB
