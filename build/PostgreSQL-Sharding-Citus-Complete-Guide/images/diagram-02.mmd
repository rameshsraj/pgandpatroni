flowchart TD
    Client["Application"]
    Coord["Coordinator<br/>parses the SQL, hashes the filter,<br/>works out which shards are involved"]
    D{"Does the query filter<br/>on the shard key?"}

    subgraph Workers["Worker nodes"]
        W1["worker-1"]
        W2["worker-2"]
        W3["worker-3"]
    end

    Combine["Coordinator combines<br/>the partial results"]

    Client --> Coord --> D
    D -->|"Yes. One shard,<br/>so one worker."| W1
    D -->|"No. Every shard,<br/>so every worker."| W2
    D -.-> W3
    W1 --> Combine
    W2 --> Combine
    W3 --> Combine
    Combine --> Client

    style Client fill:#607D8B,color:#fff
    style Coord fill:#FF9800,color:#fff
    style D fill:#FFC107,color:#000
    style W1 fill:#4CAF50,color:#fff
    style W2 fill:#2196F3,color:#fff
    style W3 fill:#9C27B0,color:#fff
    style Combine fill:#FF9800,color:#fff